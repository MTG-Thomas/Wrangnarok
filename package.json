{
  "name": "wrangnarok",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "dev:ui": "vite build --config client/vite.config.ts --watch",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p client && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build:ui && wrangler deploy --dry-run",
    "build:dev": "npm run build:ui && wrangler deploy --dry-run --env dev",
    "build:ui": "vite build --config client/vite.config.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed-local.mjs",
    "fixture": "node scripts/echo-server.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.6",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.130.0"
  }
}
