{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wrangnarok-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./client/dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "LAB_ENABLED": "false",
    "LAB_TOKEN": "",
    "LAB_ORG_ID": "",
    "LAB_USER_ID": "",
    "NINJA_CLIENT_ID": "",
    "NINJA_CLIENT_SECRET": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wrangnarok-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "workflows": [{
    "binding": "ECHO_WORKFLOW",
    "name": "wrangnarok-echo-v1",
    "class_name": "EchoWorkflow"
  }, {
    "binding": "NINJA_WORKFLOW",
    "name": "wrangnarok-ninjaone-orgs-v1",
    "class_name": "NinjaOrgsWorkflow"
  }]
}
